rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // deny-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    // Public: stations summary read (safe fields only)
    match /stations/{stationId} {
      allow read: if true;
      allow write: if false;

      match /queue/{plate} {
        allow read, write: if false;
      }
    }

    // Users: can read own profile
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Config: allow read of config/app (clients may need)
    match /config/{docId} {
      allow read: if docId == "app";
      allow write: if false;
    }

    // Ratings must only be written via HTTPS function (no client writes)
    match /vehicleRatings/{ratingId} {
      allow read, write: if false;
    }

    // Everything else: server only (admin SDK / functions)
    match /vehicles/{plate} { allow read, write: if false;
      match /drivers/{uid} { allow read, write: if false; }
    }

    match /driverClaims/{id} { allow read, write: if false; }
    match /dispatchTokens/{id} { allow read, write: if false; }
    match /dispatchPaymentClaims/{id} { allow read, write: if false; }
    match /paymentAcks/{id} { allow read, write: if false; }

    match /designations/{id} { allow read, write: if false; }
    match /designationChecks/{id} { allow read, write: if false; }

    match /employeeCredentials/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }

    // Legacy/deprecated collections: no client access
    match /vehicleCredentials/{id} { allow read, write: if false;
      match /helpers/{uid} { allow read, write: if false; }
    }
    match /vehicleClaims/{id} { allow read, write: if false; }
    match /payments/{id} { allow read, write: if false; }
    match /rebalancingOrders/{id} { allow read, write: if false; }
  }
}
